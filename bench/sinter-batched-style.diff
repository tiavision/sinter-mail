@@ -43,3 +43,24 @@ export function urlAllowed(el: Element, name: string, value: string, base: strin
 /** Style values that could load URLs. */
 export const STYLE_BAD = /url\(|image(-set)?\(|\\/i;
 
+
+/**
+ * Whether a style value (already past STYLE_BAD) stays one declaration's value when written into a
+ * declaration block (`style.cssText`), as `setProperty` would take it alone: nothing that ends the
+ * declaration or the block (`;`, `{`, `}`), no `!` (`!important`), no comment, and its quotes and
+ * parentheses closed, so that what follows it in the block is not read as part of it. A value that is
+ * not is written with `setProperty` instead.
+ */
+export function declSafe(v: string): boolean {
+  if (!/[;{}!"'()]|\/\*/.test(v)) return true;
+  if (/[;{}!]|\/\*/.test(v)) return false;
+  let depth = 0, q = '';
+  for (let i = 0; i < v.length; i++) {
+    const c = v[i]!;
+    if (q) { if (c == q) q = ''; }
+    else if (c == '"' || c == "'") q = c;
+    else if (c == '(') depth++;
+    else if (c == ')' && --depth < 0) return false;
+  }
+  return !q && !depth;
+}
